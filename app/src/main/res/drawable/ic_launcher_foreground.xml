<?xml version="1.0" encoding="utf-8"?>
<!-- Logo do Vinil: disco com sulcos, reflexo e selo central com o triângulo de "play".
     Fica dentro da zona segura de 66dp do ícone adaptativo (raio 33 a partir do centro). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Disco -->
    <path
        android:fillColor="@color/vinil_disc"
        android:pathData="M24,54a30,30 0,1 0,60 0a30,30 0,1 0,-60 0z" />
    <!-- Sulcos -->
    <path
        android:pathData="M29,54a25,25 0,1 0,50 0a25,25 0,1 0,-50 0z"
        android:strokeWidth="0.8"
        android:strokeColor="@color/vinil_groove" />
    <path
        android:pathData="M33,54a21,21 0,1 0,42 0a21,21 0,1 0,-42 0z"
        android:strokeWidth="0.8"
        android:strokeColor="@color/vinil_groove" />
    <path
        android:pathData="M37,54a17,17 0,1 0,34 0a17,17 0,1 0,-34 0z"
        android:strokeWidth="0.8"
        android:strokeColor="@color/vinil_groove" />
    <!-- Reflexo -->
    <path
        android:pathData="M29.1,44.9A26.5,26.5 0,0 1,44.9 29.1"
        android:strokeWidth="2"
        android:strokeColor="#40FFFFFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M79,63.1A26.5,26.5 0,0 1,63.1 79"
        android:strokeWidth="2"
        android:strokeColor="#26FFFFFF"
        android:strokeLineCap="round" />
    <!-- Selo central -->
    <path
        android:fillColor="@color/vinil_label"
        android:pathData="M42,54a12,12 0,1 0,24 0a12,12 0,1 0,-24 0z" />
    <!-- Play -->
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M50.5,47.5L61,54L50.5,60.5z" />
</vector>
